---
import { experience, certifications, education } from "@/lib/timeline"
---

<div class="row">
  <ul class="timeline">
    <li class="timeline-item period">
      <div class="timeline-info"></div>
      <div class="timeline-marker"></div>
      <div class="timeline-content">
        <h2>Experience</h2>
      </div>
    </li>
    {
      experience.map(item => (
        <li class="timeline-item">
          <div class="timeline-info">
            <span>{item.period}</span>
          </div>
          <div class="timeline-marker" />
          <div class="timeline-content">
            <h3>{item.title}</h3>
            <h4>{item.company}</h4>
            <p>{item.description}</p>
            <p>
              <strong>Technologies</strong>: {item.technologies}
            </p>
          </div>
        </li>
      ))
    }

    <li class="timeline-item period">
      <div class="timeline-info"></div>
      <div class="timeline-marker"></div>
      <div class="timeline-content">
        <h2>Certifications</h2>
      </div>
    </li>
    {
      certifications.map(item => (
        <li class="timeline-item">
          <div class="timeline-info">
            <span>{item.date}</span>
          </div>
          <div class="timeline-marker" />
          <div class="timeline-content">
            <h3>{item.title}</h3>
            <h4>{item.company}</h4>
          </div>
        </li>
      ))
    }

    <li class="timeline-item period">
      <div class="timeline-info"></div>
      <div class="timeline-marker"></div>
      <div class="timeline-content">
        <h2>Education</h2>
      </div>
    </li>
    {
      education.map(item => (
        <li class="timeline-item">
          <div class="timeline-info" />
          <div class="timeline-marker" />
          <div class="timeline-content">
            <h3>{item.title}</h3>
            <h4>{item.school}</h4>
            <p>{item.description}</p>
            <p>
              Graduated with {item.withHonors ? "honors and" : "an"} average grade of <strong>{item.grade}</strong>.
            </p>
          </div>
        </li>
      ))
    }

    <li class="timeline-item period">
      <div class="timeline-info"></div>
      <div class="timeline-marker"></div>
      <div class="timeline-content">
        <h2>Skills</h2>
      </div>
    </li>
  </ul>
</div>

<style>
  .row {
    max-width: 700px;
    margin: 0 auto;
    padding: 0 1rem;
  }
</style>
