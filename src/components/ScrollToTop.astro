<button type="button" id="to-top" class="hint--top" aria-label="To top">
  <span class="scroll-to-top">
    <svg width="100%" height="100%" viewBox="-1 -1 102 102">
      <path d="M50,1 a49,49 0 0,1 0,98 a49,49 0 0,1 0,-98"></path>
    </svg>
  </span>
</button>

<script>
  const path = document.querySelector<SVGPathElement>(".scroll-to-top path")
  const button = document.querySelector(".scroll-to-top")
  if (path && button) {
    const pathLength = path.getTotalLength()
    path.style.strokeDasharray = `${pathLength} ${pathLength}`

    const updateProgress = () => {
      const scrolled = window.scrollY
      const height = document.documentElement.scrollHeight - window.innerHeight
      path.style.strokeDashoffset = String(pathLength - (scrolled * pathLength) / height)
      button.classList.toggle("active-progress", scrolled > 50)
    }

    updateProgress()
    window.addEventListener("scroll", updateProgress)

    button.addEventListener("click", event => {
      event.preventDefault()
      window.scrollTo({ top: 0, behavior: "smooth" })
    })
  }
</script>
