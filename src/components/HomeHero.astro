---
import { skills } from "@/lib/skills"

/** Curated, backend-focused subset of skills.ts for the hero chips — not a full skill list (see about/CV). */
const heroStackNames = ["Java", "Spring", "Microservices", "REST/SOAP", "GraphQL", "React", "AI"]
const heroStack = heroStackNames
  .map(name => skills.find(skill => skill.name === name))
  .filter((skill): skill is (typeof skills)[number] => Boolean(skill))
---

<header id="intro" class="hero">
  <div class="hero-copy">
    <p class="eyebrow">deveuge — senior software engineer</p>
    <h1>I <em>rebuild</em> backend systems that outgrew their first design.</h1>
    <p class="lede">
      Eight years of Java/Spring work on small teams: rescuing legacy code, fixing concurrency problems, and
      shipping code that holds up and that the next person can trust. Currently modernizing this very site — in
      phases, like everything else I build.
    </p>
    <ul class="stack-chips">
      {heroStack.map(skill => <li>{skill.name}</li>)}
    </ul>
    <div class="hero-ctas">
      <a class="cta-primary" href="/projects/">View the work →</a>
      <a class="cta-ghost" href="#career-changelog">Read the changelog</a>
    </div>
  </div>

  <svg class="hero-art" viewBox="0 0 300 300" fill="none" xmlns="http://www.w3.org/2000/svg" role="presentation">
    <rect x="0.5" y="0.5" width="299" height="299" rx="6" stroke="var(--color-line)"></rect>
    <g class="wires" stroke="var(--color-primary)" stroke-width="1.2" opacity="0.35">
      <path class="p1" d="M110 250 V150 H190 V60"></path>
      <path class="p2" d="M190 60 H70 V110"></path>
      <path class="p3" d="M110 150 H150"></path>
      <path class="p4" d="M70 110 V200 H250"></path>
      <path class="p5" d="M190 110 V250 H100 V180"></path>
    </g>
    <g fill="var(--color-accent)">
      <circle class="node-a" cx="110" cy="250" r="4"></circle>
      <circle class="node-b" cx="190" cy="60" r="4"></circle>
      <circle class="node-c" cx="70" cy="110" r="4"></circle>
      <circle class="node-d" cx="250" cy="200" r="4"></circle>
    </g>
    <g fill="var(--color-primary)">
      <circle class="node-m1" cx="150" cy="150" r="3"></circle>
      <circle class="node-m2" cx="190" cy="250" r="3"></circle>
      <circle class="node-m3" cx="100" cy="180" r="3"></circle>
    </g>
  </svg>
</header>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
    max-width: 1040px;
    margin: 0 auto;
    padding: 3rem 1rem 2rem;
  }

  @media (min-width: 900px) {
    .hero {
      grid-template-columns: 3fr 2fr;
      padding: 4.5rem 1.5rem 3rem;
    }
  }

  .eyebrow {
    margin: 0 0 1rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  .hero h1 {
    margin: 0 0 1.25rem;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    line-height: 1.1;
    color: var(--color-text);
  }

  .hero h1 em {
    color: var(--color-accent);
    font-style: italic;
  }

  .lede {
    margin: 0 0 1.75rem;
    max-width: 42rem;
    font-size: 1.05rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .stack-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 2rem;
    padding: 0;
    list-style: none;
  }

  .stack-chips li {
    padding: 0.3rem 0.65rem;
    border: 1px solid var(--color-line);
    border-radius: 4px;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .hero-ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
  }

  .cta-primary {
    padding: 0.75rem 1.3rem;
    background: var(--color-primary);
    color: var(--color-on-primary);
    border-radius: 4px;
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 500;
    transition: opacity 0.2s;
  }

  .cta-primary:hover {
    opacity: 0.85;
  }

  .cta-ghost {
    color: var(--color-text-muted);
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    border-bottom: 1px solid var(--color-line);
    padding-bottom: 0.15rem;
    transition: color 0.2s;
  }

  .cta-ghost:hover {
    color: var(--color-accent);
    border-color: var(--color-accent);
  }

  .hero-art {
    display: none;
    width: 100%;
    height: auto;
  }

  @media (min-width: 900px) {
    .hero-art {
      display: block;
    }
  }

  /* The diagram loads in a tangled state and settles into the clean,
     orthogonal layout once — a small visual echo of "I rebuild backend
     systems that outgrew their first design" rather than decoration for
     its own sake. */
  .hero-art .wires {
    animation: settle-wires 1.1s 0.4s ease-in-out forwards;
  }

  .hero-art .p1 {
    animation: settle-p1 1.1s 0.4s ease-in-out forwards;
  }
  .hero-art .p2 {
    animation: settle-p2 1.1s 0.4s ease-in-out forwards;
  }
  .hero-art .p3 {
    animation: settle-p3 1.1s 0.4s ease-in-out forwards;
  }
  .hero-art .p4 {
    animation: settle-p4 1.1s 0.4s ease-in-out forwards;
  }
  .hero-art .p5 {
    animation: settle-p5 1.1s 0.4s ease-in-out forwards;
  }

  .hero-art .node-a {
    animation: settle-node-a 1.1s 0.4s ease-in-out forwards;
  }
  .hero-art .node-b {
    animation: settle-node-b 1.1s 0.4s ease-in-out forwards;
  }
  .hero-art .node-c {
    animation: settle-node-c 1.1s 0.4s ease-in-out forwards;
  }
  .hero-art .node-d {
    animation: settle-node-d 1.1s 0.4s ease-in-out forwards;
  }
  .hero-art .node-m1 {
    animation: settle-node-m1 1.1s 0.4s ease-in-out forwards;
  }
  .hero-art .node-m2 {
    animation: settle-node-m2 1.1s 0.4s ease-in-out forwards;
  }
  .hero-art .node-m3 {
    animation: settle-node-m3 1.1s 0.4s ease-in-out forwards;
  }

  @keyframes settle-wires {
    to {
      opacity: 0.55;
    }
  }
  @keyframes settle-p1 {
    to {
      d: path("M40 240 V150 H120 V70");
    }
  }
  @keyframes settle-p2 {
    to {
      d: path("M120 70 H220 V130");
    }
  }
  @keyframes settle-p3 {
    to {
      d: path("M40 150 H90");
    }
  }
  @keyframes settle-p4 {
    to {
      d: path("M220 130 V200 H260");
    }
  }
  @keyframes settle-p5 {
    to {
      d: path("M120 130 V240 H180 V200");
    }
  }
  @keyframes settle-node-a {
    to {
      cx: 40px;
      cy: 240px;
    }
  }
  @keyframes settle-node-b {
    to {
      cx: 120px;
      cy: 70px;
    }
  }
  @keyframes settle-node-c {
    to {
      cx: 220px;
      cy: 130px;
    }
  }
  @keyframes settle-node-d {
    to {
      cx: 260px;
      cy: 200px;
    }
  }
  @keyframes settle-node-m1 {
    to {
      cx: 90px;
      cy: 150px;
    }
  }
  @keyframes settle-node-m2 {
    to {
      cx: 120px;
      cy: 240px;
    }
  }
  @keyframes settle-node-m3 {
    to {
      cx: 180px;
      cy: 200px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-art .wires,
    .hero-art .p1,
    .hero-art .p2,
    .hero-art .p3,
    .hero-art .p4,
    .hero-art .p5,
    .hero-art .node-a,
    .hero-art .node-b,
    .hero-art .node-c,
    .hero-art .node-d,
    .hero-art .node-m1,
    .hero-art .node-m2,
    .hero-art .node-m3 {
      animation: none;
    }

    .hero-art .wires {
      opacity: 0.55;
    }

    .hero-art .p1 {
      d: path("M40 240 V150 H120 V70");
    }
    .hero-art .p2 {
      d: path("M120 70 H220 V130");
    }
    .hero-art .p3 {
      d: path("M40 150 H90");
    }
    .hero-art .p4 {
      d: path("M220 130 V200 H260");
    }
    .hero-art .p5 {
      d: path("M120 130 V240 H180 V200");
    }
    .hero-art .node-a {
      cx: 40px;
      cy: 240px;
    }
    .hero-art .node-b {
      cx: 120px;
      cy: 70px;
    }
    .hero-art .node-c {
      cx: 220px;
      cy: 130px;
    }
    .hero-art .node-d {
      cx: 260px;
      cy: 200px;
    }
    .hero-art .node-m1 {
      cx: 90px;
      cy: 150px;
    }
    .hero-art .node-m2 {
      cx: 120px;
      cy: 240px;
    }
    .hero-art .node-m3 {
      cx: 180px;
      cy: 200px;
    }
  }
</style>
