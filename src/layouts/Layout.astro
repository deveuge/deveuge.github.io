---
import "@/styles/global.css"
import Navbar from "@/components/Navbar.astro"
import Footer from "@/components/Footer.astro"
import ScrollToTop from "@/components/ScrollToTop.astro"
import KeyboardShortcuts from "@/components/KeyboardShortcuts.astro"
import TerminalModal from "@/components/TerminalModal.astro"
import { SITE } from "@/lib/site"

interface Props {
  title: string
  description?: string
}

const { title, description = SITE.description } = Astro.props
const canonicalURL = new URL(Astro.url.pathname, Astro.site)
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/icon-512.png" />
    <link rel="manifest" href="/manifest.json" />
    <meta name="theme-color" content="#24406b" />
    <link rel="canonical" href={canonicalURL} />

    <title>{title} | {SITE.title}</title>
    <meta name="description" content={description} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,700;8..60,900&family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap"
      media="print"
      onload="this.media='all'"
    />

    <!-- Subset of Font Awesome with only the glyphs used across src/; see scripts/build-fa-subset.mjs. -->
    <link rel="stylesheet" href="/css/fontawesome-subset.css" media="print" onload="this.media='all'" />
    <!-- Subset of Devicon with only the glyphs used across src/; see scripts/build-devicon-subset.mjs. -->
    <link rel="stylesheet" href="/css/devicon-subset.css" media="print" onload="this.media='all'" />
    <link rel="stylesheet" href="/css/hint.min.css" media="print" onload="this.media='all'" />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Source+Serif+4:opsz,wght@8..60,700;8..60,900&family=IBM+Plex+Sans:wght@400;500;600&family=JetBrains+Mono:wght@400;500;600&display=swap"
      />
      <link rel="stylesheet" href="/css/fontawesome-subset.css" />
      <link rel="stylesheet" href="/css/devicon-subset.css" />
      <link rel="stylesheet" href="/css/hint.min.css" />
    </noscript>
    <slot name="head" />

    <script is:inline>
      // Blocking, runs before first paint to avoid a flash of the wrong theme.
      const storageKey = "theme-preference"
      const stored = localStorage.getItem(storageKey)
      const preferred = stored ?? "dark"
      document.documentElement.setAttribute("data-theme", preferred)
    </script>
  </head>
  <body class="text-text font-sans">
    <Navbar />

    <main id="main">
      <div class="main-container">
        <slot />
      </div>
      <Footer />
    </main>

    <ScrollToTop />
    <KeyboardShortcuts />
    <TerminalModal />

    <script>
      import { SITE } from "@/lib/site"

      const asciiArt = String.raw`
██████╗ ███████╗██╗   ██╗███████╗██╗   ██╗ ██████╗ ███████╗
██╔══██╗██╔════╝██║   ██║██╔════╝██║   ██║██╔════╝ ██╔════╝
██║  ██║█████╗  ██║   ██║█████╗  ██║   ██║██║  ███╗█████╗
██║  ██║██╔══╝  ╚██╗ ██╔╝██╔══╝  ██║   ██║██║   ██║██╔══╝
██████╔╝███████╗ ╚████╔╝ ███████╗╚██████╔╝╚██████╔╝███████╗
╚═════╝ ╚══════╝  ╚═══╝  ╚══════╝ ╚═════╝  ╚═════╝ ╚══════╝`

      console.log(
        "%c" +
          asciiArt +
          "%c\n\n// relax, this console.log is not a bug — it's a feature\n\nSenior Java/Spring backend engineer, still shipping this very site in phases. If you read the console, you probably read diffs too.\n\ngithub   → https://github.com/%s\nlinkedin → https://www.linkedin.com/in/%s\n\nAnyway, back to your own bugs.",
        "color:#8fa9d6;font-family:monospace;font-size:9px;line-height:1.1;font-weight:700;white-space:pre;",
        "color:#a2aabb;font-family:monospace;font-size:12px;line-height:1.6;",
        SITE.social.github,
        SITE.social.linkedin,
      )

      const progressBar = document.querySelector<HTMLProgressElement>("progress")
      if (progressBar) {
        const updateProgress = () => {
          progressBar.max = document.documentElement.scrollHeight - window.innerHeight
          progressBar.value = window.scrollY
        }
        updateProgress()
        window.addEventListener("scroll", updateProgress)
        window.addEventListener("resize", updateProgress)
      }

      const revealEls = document.querySelectorAll<HTMLElement>("[data-reveal]")
      if (revealEls.length > 0) {
        if ("IntersectionObserver" in window) {
          const observer = new IntersectionObserver(
            entries => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue
                entry.target.classList.add("is-revealed")
                observer.unobserve(entry.target)
              }
            },
            { rootMargin: "0px 0px -10% 0px" },
          )
          revealEls.forEach(el => observer.observe(el))
        } else {
          revealEls.forEach(el => el.classList.add("is-revealed"))
        }
      }
    </script>
  </body>
</html>

<style>
  #main {
    position: relative;
    overflow: hidden;
    box-shadow: 0 1px 10px -5px rgba(0, 0, 0, 0.5);
    transition: transform 0.5s;
    margin: 0;
    padding: 0;
    z-index: 1;
    min-height: calc(100vh - 4rem);
    display: flex;
    flex-direction: column;

    /* Muted "workspace" backdrop for the actual page surface: a
       --color-primary blob (ink-blue — dark blue in light mode, light blue
       in dark mode) plus a --color-accent blob at very low alpha for a
       second hue the gradient actually reads, over a wide-spaced dot grid.
       Pinned to the viewport (background-attachment: fixed) instead of
       scrolling with the page. */
    background-color: var(--color-background);
    background-image:
      radial-gradient(circle at 12% 8%, color-mix(in srgb, var(--color-primary) 10%, transparent), transparent 55%),
      radial-gradient(circle at 88% 92%, color-mix(in srgb, var(--color-accent) 6%, transparent), transparent 55%),
      radial-gradient(circle, color-mix(in srgb, var(--color-line) 70%, transparent) 1px, transparent 1px);
    background-size:
      100% 100%,
      100% 100%,
      34px 34px;
    background-repeat: no-repeat, no-repeat, repeat;
    background-attachment: fixed, fixed, fixed;
  }

  #main > .main-container {
    flex: 1 0 auto;
  }
</style>
