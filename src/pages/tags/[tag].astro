---
import { getCollection, type CollectionEntry } from "astro:content"
import Layout from "@/layouts/Layout.astro"
import ProjectCard from "@/components/ProjectCard.astro"
import ProjectGrid from "@/components/ProjectGrid.astro"
import { slugifyTag } from "@/lib/tags"

export async function getStaticPaths() {
  const projects = await getCollection("projects")

  const tagsBySlug = new Map<string, string>()
  for (const project of projects) {
    for (const tag of project.data.tags) {
      tagsBySlug.set(slugifyTag(tag), tag)
    }
  }

  return Array.from(tagsBySlug, ([slug, tag]) => {
    const matchingProjects = projects
      .filter(project => project.data.tags.includes(tag))
      .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())

    return { params: { tag: slug }, props: { tag, matchingProjects } }
  })
}

interface Props {
  tag: string
  matchingProjects: CollectionEntry<"projects">[]
}

const { tag, matchingProjects } = Astro.props
const count = matchingProjects.length
---

<Layout title={`Tagged: ${tag}`}>
  <div class="row container-66">
    <p class="eyebrow">// tagged</p>
    <h1 class="section-title">{tag}</h1>
    <p class="count">
      {count} project{count === 1 ? "" : "s"}
    </p>
  </div>

  <div class="row container-66">
    <ProjectGrid>
      {matchingProjects.map(project => <ProjectCard project={project} variant="grid" />)}
    </ProjectGrid>
  </div>

  <div id="nav-buttons" class="row container-66">
    <a href="/projects/" data-reveal="right"><span class="fa-solid fa-angles-left"></span> All projects</a>
  </div>
</Layout>

<style>
  .row {
    margin: 0 auto;
    padding: 0 1rem;
  }

  .eyebrow {
    margin: 2.5rem 0 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  .section-title {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-text);
  }

  .count {
    margin: 0.5rem 0 0;
    color: var(--color-text-muted);
    font-size: 0.92rem;
  }

  #nav-buttons {
    margin: 2rem auto;
  }

  #nav-buttons > a {
    display: inline-block;
    border: 1px solid var(--color-primary);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.6rem 1.1rem;
    color: var(--color-primary);
    text-decoration: none;
    transition: 0.25s;
  }

  #nav-buttons > a:hover {
    background-color: var(--color-primary);
    color: var(--color-on-primary);
  }
</style>
