---
import Layout from "@/layouts/Layout.astro"
---

<Layout title="404">
  <article class="flex min-h-full flex-col items-center justify-center text-center">
    <div class="stack">
      <span>PAGE NOT FOUND</span>
      <span>PAGE NOT FOUND</span>
      <span>PAGE NOT FOUND</span>
    </div>
    <p class="mt-0 mb-8 italic opacity-75">Sorry! The page you are looking for does not exist.</p>
    <a href="/" class="not-found-link">Back to home</a>
  </article>
</Layout>

<style>
  .not-found-link {
    position: relative;
    padding: 0.5rem 1rem;
    background: var(--color-primary);
    color: var(--color-background);
    text-decoration: none;
    filter: drop-shadow(1px 3px 1px rgba(0, 0, 0, 0.25));
    transition: 0.25s;
  }

  .not-found-link::after {
    content: "";
    position: absolute;
    top: 0;
    left: -1rem;
    border-style: solid;
    border-width: 1.1rem 1rem 1.1rem 0;
    border-color: transparent var(--color-primary) transparent transparent;
    transition: 0.25s;
  }

  .not-found-link:hover {
    background: var(--color-accent);
  }

  .not-found-link:hover::after {
    border-color: transparent var(--color-accent) transparent transparent;
  }

  .stack {
    display: grid;
    grid-template-columns: 1fr;
    --stacks: 3;
    animation: not-found-float 6s ease-in-out infinite;
  }

  .stack > span:nth-child(1) {
    --index: 0;
  }

  .stack > span:nth-child(2) {
    --index: 1;
  }

  .stack > span:nth-child(3) {
    --index: 2;
  }

  .stack span {
    font-family: "Poppins";
    font-weight: bold;
    grid-row-start: 1;
    grid-column-start: 1;
    font-size: 4rem;
    line-height: 4rem;
    --stack-height: calc(100% / var(--stacks) - 1px);
    --inverse-index: calc(calc(var(--stacks) - 1) - var(--index));
    --clip-top: calc(var(--stack-height) * var(--index));
    --clip-bottom: calc(var(--stack-height) * var(--inverse-index));
    clip-path: inset(var(--clip-top) 0 var(--clip-bottom) 0);
    animation:
      not-found-stack 340ms cubic-bezier(0.46, 0.29, 0, 1.24) 1 backwards
        calc(var(--index) * 120ms),
      not-found-glitch 2s ease infinite 2s alternate-reverse;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-image: linear-gradient(to right, var(--color-primary) 0%, var(--color-accent) 100%);
  }

  .stack span:nth-child(odd) {
    --glitch-translate: 8px;
  }
  .stack span:nth-child(even) {
    --glitch-translate: -8px;
  }

  @keyframes not-found-stack {
    0% {
      opacity: 0;
      transform: translateX(-50%);
      text-shadow:
        -2px 3px 0 var(--color-primary),
        2px -3px 0 var(--color-accent);
    }
    60% {
      opacity: 0.5;
      transform: translateX(50%);
    }
    80% {
      transform: none;
      opacity: 1;
      text-shadow:
        2px -3px 0 var(--color-primary),
        -2px 3px 0 var(--color-accent);
    }
    100% {
      text-shadow: none;
    }
  }

  @keyframes not-found-glitch {
    0% {
      text-shadow:
        -2px 3px 0 var(--color-primary),
        2px -3px 0 var(--color-accent);
      transform: translate(var(--glitch-translate));
    }
    2% {
      text-shadow:
        2px -3px 0 var(--color-primary),
        -2px 3px 0 var(--color-accent);
    }
    4%,
    100% {
      text-shadow: none;
      transform: none;
    }
  }

  @keyframes not-found-float {
    0% {
      transform: translatey(0);
    }
    50% {
      transform: translatey(-1rem);
    }
    100% {
      transform: translatey(0);
    }
  }
</style>
