---
import Layout from "@/layouts/Layout.astro"
import Button from "@/components/Button.astro"
import Card from "@/components/Card.astro"
---

<Layout title="Home">
  <div class="p-8">
    <h1 class="font-heading mb-6 text-3xl">Layout skeleton — Phase 3</h1>

    <div class="flex flex-wrap gap-4">
      <Card title="Sample card">
        <p class="mb-4">Body text on a surface background, with primary/accent tokens.</p>
        <div class="flex gap-2">
          <Button href="#" variant="primary">Primary</Button>
          <Button href="#" variant="accent">Accent</Button>
        </div>
      </Card>
    </div>
  </div>
</Layout>
